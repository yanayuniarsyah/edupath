<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jika pengunjung membuka domain utama (tanpa path apapun)
  RewriteRule ^$ dist/index.html [L]

  # Arahkan request aset langsung ke folder dist
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # Arahkan favicon
  RewriteRule ^favicon\.ico$ dist/favicon.ico [L]
  RewriteRule ^favicon\.svg$ dist/favicon.svg [L]

  # Jangan ganggu jika mengakses API / folder server
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [L]

  # Untuk semua request lain, jika file tidak ada di root,
  # alihkan ke dist/index.html (History Mode Vue)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>
