# EduPath Uploads Directory Security Enforcement
# Completely block execution of scripts inside uploads directory

# Disable PHP engine
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>

# Strip script execution handlers
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .asp .jsp .sh .bash
SetHandler default-handler

# Deny direct access to all executable or config file patterns
<FilesMatch "(?i)\.(php|phtml|php[34578]|phar|cgi|pl|py|asp|jsp|sh|bash|env|config|htaccess|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# Prevent directory indexing
Options -Indexes -ExecCGI
