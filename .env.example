# ============================================================
# EDUPath Frontend — Environment Variables Template
# ============================================================
# Salin file ini menjadi:
#   .env.development  → untuk development lokal
#   .env.production   → untuk production build
# JANGAN commit file .env* yang berisi nilai asli ke Git
# (kecuali .env.example ini)
# ============================================================

# URL API Backend EDUPath
# Development: http://localhost/edupath/api  (jika pakai XAMPP)
# Production : https://edupath.co.id/api
VITE_API_URL=

# Midtrans Client Key (PUBLIC — boleh ada di frontend)
# Dapatkan dari dashboard Midtrans
# Sandbox  : SB-Mid-client-XXXXXX
# Production: Mid-client-XXXXXX
VITE_MIDTRANS_CLIENT_KEY=

# URL Midtrans Snap Script
# Sandbox  : https://app.sandbox.midtrans.com/snap/snap.js
# Production: https://app.midtrans.com/snap/snap.js
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# App environment (development / production)
VITE_APP_ENV=development
