# ============================================================
# EDUPath Backend — Environment Variables Template
# ============================================================
# Salin file ini menjadi .env di server (api/.env)
# JANGAN commit file .env yang berisi nilai asli ke Git
# ============================================================

# --- Database Configuration ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- JWT Configuration ---
# Hasilkan string random minimal 32 karakter untuk production
# Contoh generate: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Durasi access token dalam detik (default: 86400 = 24 jam)
JWT_ACCESS_TTL=86400
# Durasi refresh token dalam hari (default: 30)
JWT_REFRESH_TTL_DAYS=30

# --- Midtrans Configuration ---
# Dapatkan dari dashboard Midtrans: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Set ke 'true' untuk production, 'false' untuk sandbox
MIDTRANS_IS_PRODUCTION=false

# --- CORS Configuration ---
# Daftar origin yang diizinkan, pisahkan dengan koma jika lebih dari satu
# Contoh development: http://localhost:5173
# Contoh production: https://edupath.co.id
ALLOWED_ORIGINS=http://localhost:5173

# --- Application Environment ---
# 'development' atau 'production'
APP_ENV=development
